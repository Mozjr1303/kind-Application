# Server Port (Render sets this automatically)
PORT=4001

# JWT Secret for signing session tokens
JWT_SECRET=your_jwt_signing_secret

# Supabase Credentials (from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Allowed CORS Origins (comma-separated, include your Vercel frontend URL)
# Example: http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Africa's Talking SMS (optional for production SMS notifications)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
ADMIN_PHONE_NUMBER=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
API_BASE_URL=
